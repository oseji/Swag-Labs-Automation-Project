{
	"name": "swaglabs-automation",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"test:auth": "npm run test:auth:login && npm run test:auth:blank && npm run test:auth:wrong",
		"test:auth:login": "ts-node tests/authentication/loadLandingPageAndLogin.test.ts",
		"test:auth:blank": "ts-node tests/authentication/loginWithBlankUsernameField.test.ts",
		"test:auth:wrong": "ts-node tests/authentication/loginWithWrongCredentials.test.ts",
		"test:auth:logout": "ts-node tests/dashboard/authentication/logoutSessionValidation.test.ts",
		"test:products": "npm run test:products:details && npm run test:products:sort",
		"test:products:details": "ts-node tests/dashboard/openProductDetailsPage.test.ts",
		"test:cart": "npm run test:cart:add && npm run test:cart:checkout",
		"test:cart:add": "ts-node tests/dashboard/checking-out/addProductToCart.test.ts",
		"test:cart:checkout": "ts-node tests/dashboard/checking-out/addToCartAndCheckout.test.ts",
		"test:sort": "npm run test:sort:az && npm run test:sort:za && npm run test:sort:price-low && npm run test:sort:price-high",
		"test:sort:az": "ts-node tests/dashboard/product-sorting/sortProductsByAToZ.test.ts",
		"test:sort:za": "ts-node tests/dashboard/product-sorting/sortProductsByZToA.test.ts",
		"test:sort:price-low": "ts-node tests/dashboard/product-sorting/sortProductsByLowToHigh.test.ts",
		"test:sort:price-high": "ts-node tests/dashboard/product-sorting/sortProductsByHighToLow.test.ts",
		"test:menu": "npm run test:menu:visibility && npm run test:menu:reset && npm run test:menu:about",
		"test:menu:visibility": "ts-node tests/dashboard/menu/menuVisibilityAndContent.test.ts",
		"test:menu:reset": "ts-node tests/dashboard/menu/resetAppStateValidation.test.ts",
		"test:menu:about": "ts-node tests/dashboard/menu/goToAboutPage.test.ts",
		"test:all": "npm run test:auth && npm run test:products && npm run test:cart && npm run test:sort && npm run test:menu"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "commonjs",
	"dependencies": {
		"chai": "^6.2.2",
		"dotenv": "^17.2.3",
		"selenium-webdriver": "^4.39.0"
	},
	"devDependencies": {
		"@types/node": "^25.0.3",
		"@types/selenium-webdriver": "^4.35.4",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3"
	}
}
