{
    "name": "swaglabs-automation",
    "version": "1.0.0",
    "description": "E2E UI automation suite for Swag Labs (saucedemo.com)",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "npm run test:all",
        "test:all": "mocha 'tests/**/*.test.ts'",
        "test:auth": "mocha 'tests/authentication/**/*.test.ts'",
        "test:auth:login": "mocha tests/authentication/loginWithValidCredentials.test.ts",
        "test:auth:blank": "mocha tests/authentication/loginWithEmptyUsernameValidation.test.ts",
        "test:auth:wrong": "mocha tests/authentication/loginWithInvalidCredentialsValidation.test.ts",
        "test:auth:logout": "mocha tests/authentication/logoutAndSessionPersistenceValidation.test.ts",
        "test:auth:protected-route": "mocha tests/authentication/protectedRouteAccessWithoutLoginValidation.test.ts",
        "test:products": "mocha 'tests/dashboard/product-sorting/**/*.test.ts'",
        "test:products:details": "mocha tests/dashboard/product-sorting/openProductDetailsPageValidation.test.ts",
        "test:cart": "mocha 'tests/dashboard/checking-out/**/*.test.ts'",
        "test:cart:add": "mocha tests/dashboard/checking-out/addProductToCartAndVerifyCartBadgeCount.test.ts",
        "test:cart:remove": "mocha tests/dashboard/checking-out/addAndRemoveProductsFromCartValidation.test.ts",
        "test:cart:checkout": "mocha tests/dashboard/checking-out/checkoutFlowWithFormErrorAndPriceValidation.test.ts",
        "test:sort": "mocha 'tests/dashboard/product-sorting/sort*.test.ts'",
        "test:sort:az": "mocha tests/dashboard/product-sorting/sortProductsAlphabeticallyAToZ.test.ts",
        "test:sort:za": "mocha tests/dashboard/product-sorting/sortProductsAlphabeticallyZToA.test.ts",
        "test:sort:price-low": "mocha tests/dashboard/product-sorting/sortProductsByPriceLowToHigh.test.ts",
        "test:sort:price-high": "mocha tests/dashboard/product-sorting/sortProductsByPriceHighToLow.test.ts",
        "test:menu": "mocha 'tests/dashboard/menu/**/*.test.ts'",
        "test:menu:visibility": "mocha tests/dashboard/menu/menuVisibilityAndContentValidation.test.ts",
        "test:menu:reset": "mocha tests/dashboard/menu/resetAppStateFromMenuValidation.test.ts",
        "test:menu:about": "mocha tests/dashboard/menu/navigateToAboutPageFromMenu.test.ts",
        "report:auth": "rimraf allure-results allure-report && npm run test:auth; allure generate allure-results -o allure-report && allure open allure-report",
        "report:cart": "rimraf allure-results allure-report && npm run test:cart; allure generate allure-results -o allure-report && allure open allure-report",
        "report:sort": "rimraf allure-results allure-report && npm run test:sort; allure generate allure-results -o allure-report && allure open allure-report",
        "report:products": "rimraf allure-results allure-report && npm run test:products; allure generate allure-results -o allure-report && allure open allure-report",
        "report:menu": "rimraf allure-results allure-report && npm run test:menu; allure generate allure-results -o allure-report && allure open allure-report",
        "report:all": "rimraf allure-results allure-report && npm run test:all; allure generate allure-results -o allure-report && allure open allure-report"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "devDependencies": {
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "^25.0.3",
        "@types/selenium-webdriver": "^4.35.4",
        "allure-js-commons": "^3.9.0",
        "allure-mocha": "^3.9.0",
        "chai": "^6.2.2",
        "dotenv": "^17.2.3",
        "mocha": "^11.7.5",
        "rimraf": "^6.1.3",
        "selenium-webdriver": "^4.39.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    }
}
